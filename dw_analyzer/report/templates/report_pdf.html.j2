<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
@page { size: A4 landscape; margin: 10mm; }
body { font: 9pt/1.35 "DejaVu Sans", sans-serif; color: #1d1d1f; }
h1 { font-size: 16pt; margin: 0 0 2pt; }
h2 { font-size: 11pt; margin: 12pt 0 4pt; }
.sub { color: #6e6e73; margin: 0; }
.tiles { display: flex; flex-wrap: wrap; }
.tile { box-sizing: border-box; width: 23%; margin: 0 2% 4pt 0; background: #f5f5f7; border-radius: 4pt; padding: 3pt 6pt; }
.tile .label { display: block; color: #6e6e73; font-size: 7.5pt; }
.tile .value { display: block; font-weight: bold; white-space: pre-line; }
img { width: 100%; display: block; }
.card { border: 0.75pt solid #e5e5ea; border-radius: 6pt; background: #fafafc; padding: 6pt; }
.overall { display: flex; align-items: flex-start; }
.overall .tiles { width: 62%; margin-right: 2%; }
.overall .tile { width: 31%; }
.overall .zones { width: 36%; box-sizing: border-box; }
/* Float, not flex: WeasyPrint splits block content across pages, so long tables continue on the next page */
.side .map { float: left; width: 40%; }
.side .right { margin-left: 42%; }
.clear { clear: both; }
.side table { font-size: 6.5pt; background: #fff; }
.side th, .side td { padding: 1.5pt 2.5pt; }
.side td { white-space: nowrap; }
.table-label { font-size: 7.5pt; font-weight: bold; color: #6e6e73; margin: 6pt 0 2pt; }
.analysis { display: flex; justify-content: space-between; }
.analysis .plot { width: 32.5%; box-sizing: border-box; background: #fff; }
.analysis .sub { font-size: 7.5pt; }
table { border-collapse: collapse; width: 100%; font-size: 7.5pt; }
th, td { padding: 2pt 4pt; text-align: right; border-bottom: 0.5pt solid #ddd; }
th:first-child, td:first-child { text-align: left; }
th { color: #6e6e73; }
.z0 { background: #eceff1; }
.z1 { background: #cfe3f6; }
.z2 { background: #d4efd9; }
.z3 { background: #fdf0b8; }
.z4 { background: #fbd3a5; }
.z5 { background: #f6b3ae; }
.page-break { break-before: page; }
</style>
</head>
{% macro zone_attr(header, cell) %}{% if header == "HR zone" and cell != "-" %} class="z{{ cell[1] }}"{% endif %}{% endmacro %}
<body>
<h1>{{ title }}</h1>
<p class="sub">{{ subtitle }}</p>
<p class="sub">{{ run_rule }}</p>

<h2>Overall</h2>
<div class="overall">
<div class="tiles">
{% for label, value in tiles %}<div class="tile"><span class="label">{{ label }}</span><span class="value">{{ value }}</span></div>{% endfor %}
</div>
<div class="card zones"><img src="{{ zones_uri }}"></div>
</div>

<div class="page-break"></div>
<h2>Course and runs</h2>
<div class="card side">
<div class="map" id="map">{% if map_uri %}<img src="{{ map_uri }}">{% endif %}{% if map_caption %}<p class="sub">{{ map_caption }}</p>{% endif %}</div>
<div class="right" id="right">
{% if run_rows %}
<table>
<thead><tr>{% for h in run_headers %}<th>{{ h }}</th>{% endfor %}</tr></thead>
<tbody>
{% for row in run_rows %}{% set color = run_colors[loop.index0] %}<tr>{% for cell in row %}<td{% if loop.first %} style="border-left: 4pt solid {{ color }}"{% endif %}{{ zone_attr(run_headers[loop.index0], cell) }}>{{ cell }}</td>{% endfor %}</tr>
{% endfor %}
</tbody>
</table>
{% else %}
<p class="sub">No runs above {{ threshold }} km/h</p>
{% endif %}
<div class="table-label">Splits (1 km)</div>
<table>
<thead><tr>{% for h in split_headers %}<th>{{ h }}</th>{% endfor %}</tr></thead>
<tbody>
{% for row in split_rows %}<tr>{% for cell in row %}<td{{ zone_attr(split_headers[loop.index0], cell) }}>{{ cell }}</td>{% endfor %}</tr>
{% endfor %}
</tbody>
</table>
</div>
<div class="clear"></div>
</div>

<div class="page-break"></div>
<h2>Speed and heart rate</h2>
<img src="{{ timeline_uri }}">
<h2>Run analysis</h2>
<div class="analysis">
{% for uri in analysis_uris %}<div class="card plot"><img src="{{ uri }}"><p class="sub">Runs of {{ min_run }} s or more</p></div>
{% endfor %}
</div>
</body>
</html>
